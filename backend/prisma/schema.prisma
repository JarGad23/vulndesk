generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEVELOPER
}

enum Severity {
  INFO
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum VulnerabilityStatus {
  NEW
  IN_PROGRESS
  CLOSED
  RISK_ACCEPTED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  /// Stored lowercase.
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(DEVELOPER)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz
  sessions     Session[]
  imports      Import[]
  history      HistoryEntry[]
}

/// Server-side sessions, so blocking an account takes effect immediately.
model Session {
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @unique
  description     String          @default("")
  archivedAt      DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz
  imports         Import[]
  vulnerabilities Vulnerability[]
}

model Import {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @db.Uuid
  authorId      String         @db.Uuid
  fileName      String
  createdCount  Int
  reopenedCount Int
  skippedCount  Int
  createdAt     DateTime       @default(now()) @db.Timestamptz
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  history       HistoryEntry[]

  @@index([projectId, createdAt])
}

model Vulnerability {
  id            String              @id @default(uuid()) @db.Uuid
  projectId     String              @db.Uuid
  packageName   String
  advisoryId    String
  title         String
  url           String?
  severity      Severity
  affectedRange String
  status        VulnerabilityStatus @default(NEW)
  detectedAt    DateTime            @default(now()) @db.Timestamptz
  /// Null for INFO, which has no deadline.
  dueAt         DateTime?           @db.Timestamptz
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  history       HistoryEntry[]

  @@unique([projectId, packageName, advisoryId])
  @@index([status, dueAt])
  @@index([projectId, status, severity])
}

model HistoryEntry {
  id              String               @id @default(uuid()) @db.Uuid
  vulnerabilityId String               @db.Uuid
  authorId        String               @db.Uuid
  /// Set when the change came from an import.
  importId        String?              @db.Uuid
  /// Null for the first entry.
  fromStatus      VulnerabilityStatus?
  toStatus        VulnerabilityStatus
  /// Required by the domain logic when accepting risk.
  reason          String?
  createdAt       DateTime             @default(now()) @db.Timestamptz
  vulnerability   Vulnerability        @relation(fields: [vulnerabilityId], references: [id], onDelete: Restrict)
  author          User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  import          Import?              @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@index([vulnerabilityId, createdAt])
}
